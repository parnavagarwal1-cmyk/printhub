# PrintFlow Environment Variables Configuration
# ================================================================
# SERVER-SIDE SECRETS (Never expose to client or desktop agent)
# ================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Configuration (Accessible in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER ONLY - bypasses RLS for trusted operations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage Bucket Name
SUPABASE_STORAGE_BUCKET=printflow-documents

# Payment Gateway Selector: "razorpay" | "cashfree" | "mock"
PAYMENT_PROVIDER=mock

# Razorpay Configuration (Server Only)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Cashfree Configuration (Server Only)
CASHFREE_APP_ID=TEST_YourCashfreeAppId
CASHFREE_SECRET_KEY=TEST_YourCashfreeSecretKey
CASHFREE_WEBHOOK_SECRET=YourCashfreeWebhookSecret
CASHFREE_ENV=TEST # TEST or PRODUCTION

# Platform Super Admin Email (Automatically gets super-admin privileges)
SUPER_ADMIN_EMAILS=admin@printflow.io

# Document Retention in hours (Default 24h)
DOCUMENT_RETENTION_HOURS=24
